{
  "schema_version": 1,
  "upstream": {
    "base_url": "http://localhost:3456",
    "anthropic_version": "2023-06-01",
    "beta": [],
    "request_timeout_ms": 600000,
    "stream_retry": {
      "max_retries": 2,
      "delay_ms": 1000,
      "error_types": [
        "overloaded_error",
        "api_error"
      ]
    }
  },
  "default_max_tokens": 384000,
  "cache": {
    "system": true,
    "history": true
  },
  "default_profile": {
