{
  "name": "agent-harness-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --pretty false",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "server": "npm run build && node dist/src/server.js",
    "auth": "npm run build --silent && node dist/src/auth-cli.js",
    "test": "node -e \"require(\\\"fs\\\").rmSync(\\\"dist/test\\\",{recursive:true,force:true})\" && npm run build && node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openai-oauth/local": "2.0.0",
    "@openai-oauth/openai-client": "2.0.0",
    "@xberg-io/html-to-markdown": "^3.17.1",
    "ajv": "^8.20.0",
    "openai": "^7.28.0",
    "openai-oauth": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
