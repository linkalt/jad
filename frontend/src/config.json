{
  "api_base_path": "/api",
  "api_token_storage_key": "agent-harness.api-token",
  "stop_request_timeout_ms": 15000,
  "run_stream_reconnect_base_delay_ms": 250,
  "run_stream_reconnect_max_delay_ms": 2000,
  "run_stream_reconnect_max_attempts": 8,
  "dev_api_proxy_target": "http://127.0.0.1:8787",
  "browser_targets": {
    "chrome_major": 123,
    "firefox_major": 120,
    "safari_major": 17,
    "safari_minor": 5
  },
  "live_session_id": "playground",
  "notification_history_limit": 100,
  "show_inspector_by_default": false,
  "show_prompt_library_by_default": false,
  "close_panels_on_outside_click": true,
  "conversation_lane_default_size": 1000,
  "conversation_lane_min_size": 520,
  "conversation_lane_max_size": 2400,
  "inspector_default_size": 360,
  "inspector_min_size": 280,
  "inspector_max_size": 640,
  "left_panel_default_size": 320,
  "left_panel_min_size": 240,
  "left_panel_max_size": 560,
  "preserve_line_breaks": true,
  "paste_as_token_enabled": true,
  "paste_as_token_threshold": 2000,
  "mention_files_enabled": true,
  "mention_max_results": 50,
  "mention_files": [],
  "mention_source": "cwd",
  "defer_offscreen_transcript_rows": true,
  "transcript_row_estimate_px": 120,
  "row_height_storage_key": "agent-harness.row-heights",
  "row_height_max_entries": 2000,
  "row_height_save_delay_ms": 500,
  "row_height_width_bucket_px": 50,
  "transcript_window_messages": 16,
  "transcript_window_page_messages": 16,
  "message_step_window": 0,
  "message_step_window_page": 10,
  "scroll_debug": false,
  "scroll_settle_frames": 16,
  "scroll_drift_slack_px": 300,
  "scroll_unlock_attempts": 3,
  "composer_markdown_shortcuts": true,
  "composer_preview_enabled": true,
  "composer_draft_storage_key": "agent-harness.composer-drafts",
  "composer_draft_save_delay_ms": 300,
  "selection_quote_enabled": true,
  "selection_quote_max_chars": 2000,
  "attach_context_enabled": true,
  "attach_context_accept": ".txt,.md,.markdown,.json,.jsonl,.csv,.log,.yml,.yaml,.ts,.tsx,.js,.jsx,.py,.css,.html,.sh",
  "attach_context_max_chars_per_file": 20000,
  "attach_context_read_concurrency": 4,
  "prompt_library_storage_key": "agent-harness.prompt-library",
  "session_search_max_results": 50,
  "chunk_size_warning_limit_kb": 600,
  "reasoning_title_max_length": 80,
  "tool_output_max_chars": 12000,
  "tool_title_value_max_chars": 24,
  "tool_arguments_max_height_px": 200,
  "tool_result_max_height_px": 360,
  "copy_feedback_duration_ms": 2000,
  "mock_run_delay_ms": 1100,
  "session_refresh_interval_ms": 5000,
  "transcript_page_turns": 5,
  "session_refresh_interval_ms_streaming": 30000,
  "session_views": [],
  "session_views_storage_key": "agent-harness.session-views",
  "session_views_max": 8
}
