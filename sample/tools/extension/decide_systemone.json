{
  "schema_version": 1,
  "tools": [
    {
      "id": "extension.decide_systemone",
      "source": "extension",
      "name": "decide_systemone",
      "description": "Ask a fast classifier typed questions about some text or JSON. predicate: probability 0-1 that a condition holds. choice: the best of your choices, with confidence. score: a rating against ordered levels, lowest first. box: where a target is in an image sent in assets. Use it for yes/no checks, routing and severity, not for open-ended answers.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "array",
            "minItems": 1,
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "text"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "json"
                      ]
                    },
                    "value": {}
                  },
                  "required": [
                    "type",
                    "value"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "description": "What to evaluate, in order: a string or {type:text,text}, {type:json,value} for structured data. Every question is asked about all of it."
          },
          "questions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Label of the answer. Defaults to q1, q2, ..."
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "predicate",
                    "choice",
                    "score",
                    "box"
                  ],
                  "description": "Inferred when omitted: choices gives choice, levels gives score, otherwise predicate. box is never inferred: set it, with instructions naming the target in an image."
                },
                "instructions": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object"
                    },
                    {
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The question, with observable criteria: text, or a JSON object or array. Optional."
                },
                "criteria": {
                  "anyOf": [
                    {
                      "type": "object"
                    },
                    {
                      "type": "array",
                      "minItems": 1
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Native criteria. predicate: {true,false} meanings; choice (set type): {label: meaning}, 1-255; score (set type): ordered meanings, lowest first, 1-10. Not with choices or levels."
                },
                "choices": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "string",
                            "minLength": 1
                          },
                          "description": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "value"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "description": "Options for a choice question: a value, or a value with when it applies."
                },
                "levels": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string",
                            "minLength": 1
                          },
                          "description": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "label"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "description": "Ordered levels for a score question, lowest first: a label, or a label with its criteria."
                }
              },
              "additionalProperties": false
            }
          },
          "assets": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "format": {
                  "type": "string",
                  "enum": [
                    "png",
                    "jpg",
                    "jpeg"
                  ]
                },
                "data_base64": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "image"
                  ]
                }
              },
              "required": [
                "format",
                "data_base64"
              ],
              "additionalProperties": false
            },
            "description": "Images by reference. Key: a reference you choose (a UUID is safest), written verbatim in the input, instructions or criteria; every reference must appear. Value: a PNG or JPEG as standard padded base64. A box question needs one."
          }
        },
        "required": [
          "input",
          "questions"
        ],
        "additionalProperties": false
      }
    }
  ]
}
