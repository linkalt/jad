{
  "schema_version": 1,
  "tools": [
    {
      "id": "native.code_context",
      "source": "native",
      "name": "code_context",
      "description": "Save exact source ranges with descriptions per task, find them, and print their current code.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "read",
              "update",
              "drop",
              "get",
              "list",
              "find",
              "clear"
            ],
            "description": "read prints lines and saves them; with a description it saves them without printing. update changes an entry by id. drop removes ids. get prints the saved code. list shows the entries, or without task the tasks (the default). find searches descriptions and paths. clear deletes the task."
          },
          "task": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "description": "Task key, e.g. T-023."
          },
          "task_description": {
            "type": "string",
            "minLength": 1,
            "description": "read, update: what the task is about."
          },
          "id": {
            "type": "integer",
            "minimum": 1,
            "description": "update: the entry."
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1,
            "description": "drop, get: the entries; get without ids prints all."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "File, relative to cwd. get: only its entries."
          },
          "start": {
            "type": "integer",
            "minimum": 1,
            "description": "First line, 1-based. get: print from this line (with path or ids); default all."
          },
          "end": {
            "type": "integer",
            "minimum": 1,
            "description": "Last line, inclusive. get: print to this line; default all."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "What the code does and why it matters for the task; no line numbers."
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6,
            "description": "1 target, 2 callers/callees, 3 interfaces, 4 data, 5 tests, 6 other. get leaves out high numbers first."
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "find: words to look for."
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "description": "read, update: several in one call; fields outside items are their defaults.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "priority": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  ]
}
