{
  "schema_version": 1,
  "tools": [
    {
      "id": "native.read",
      "source": "native",
      "name": "read",
      "description": "Read file content or inspect a directory.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Path relative to cwd or an absolute path."
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          },
          "rangeType": {
            "type": "string",
            "enum": ["lines", "bytes"]
          },
          "contentEncoding": {
            "type": "string",
            "enum": ["utf8", "base64"]
          },
          "includeContent": {
            "type": "boolean",
            "description": "When false, return file metadata without reading file content."
          }
        },
        "required": ["path"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "rangeType": {"const": "lines"}
              }
            },
            "then": {
              "properties": {
                "offset": {"type": "integer", "minimum": 1}
              }
            }
          },
          {
            "if": {
              "properties": {
                "rangeType": {"const": "bytes"}
              }
            },
            "then": {
              "properties": {
                "offset": {"type": "integer", "minimum": 0}
              }
            }
          }
        ]
      }
    }
  ]
}
