{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile-toolset.schema.json",
  "title": "Jad profile's own toolset (workspace layout)",
  "description": "W/.jad/profile-own/<category>/<name>/tools/<toolset category>/<toolset name>.json: a toolset only that profile uses, named in its toolset list as profile:<toolset category>/<toolset name> (docs/design_workspace_layout.md section 21). It is not a whole toolset file (toolset.schema.json): it names a shared toolset with its scope, the tools and MCP servers of it the profile leaves out, and the few tuning keys of its tools it changes. The hooks, the MCP connections and every path, command, environment, endpoint, credential and limit of the tools always come from the base, so an edit of the base reaches it; an own toolset adds no tool, server or hook. A profile that names a file failing these rules, or whose base is missing or does not compose, is left out of the session with a warning. Sub-agents, other profiles, profile_message callers and the catalog routes never see it. An unknown key is refused.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "default": 1
    },
    "based_on": {
      "type": "string",
      "pattern": "^(global|workspace):[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "The shared toolset this one is based on, with its scope: global:<category>/<name> or workspace:<category>/<name>. Never another own toolset (profile:)."
    },
    "omit": {
      "type": "object",
      "description": "What of the base this toolset leaves out: native and extension tools by name, MCP servers by the key the base's mcp object names them with. Each must be in the base. The base's hooks always apply.",
      "properties": {
        "native": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "extension": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mcp": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "set": {
      "type": "object",
      "description": "Per native and extension tool of the base (not one it omits), the tuning keys this toolset changes, merged into the base's settings of that tool key by key; the tool's own rules judge the result, its ranges included. Every key not listed is refused, at every profile_self_edit level, also under full; a tool the base does not have cannot be set.",
