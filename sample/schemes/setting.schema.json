{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "setting.schema.json",
  "title": "Agent Harness setting.json",
  "description": "Session-specific settings, including the per-session native tool allow-list and policies.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "default": 1
    },
    "session_name": {
      "type": "string",
      "pattern": "\\S",
      "description": "Human-readable session name. Defaults to the session directory name."
    },
    "cwd": {
      "type": "string",
      "pattern": "^/",
      "description": "Working directory. Must be an absolute existing directory; it is never resolved relative to another path."
    },
    "system_prompt": {
      "type": "string",
      "description": "Mapped to the Responses API instructions field. Defaults to an empty string.",
      "default": ""
    },
    "paths": {
      "type": "object",
      "description": "Session storage paths. Relative paths resolve from the directory containing this setting.json; absolute paths are used as-is.",
      "properties": {
        "messages": {
          "type": "string",
          "pattern": "\\S",
          "description": "Transcript path. Defaults to messages.jsonl."
        },
        "model": {
          "type": "string",
          "pattern": "\\S",
          "description": "Model configuration path. Defaults to model.json."
        },
        "staging": {
          "type": "string",
          "pattern": "\\S",
          "description": "Response staging directory. Defaults to staging."
        },
        "http_debug": {
          "type": "string",
          "pattern": "\\S",
          "description": "HTTP debug directory. Defaults to debug/http."
        }
      },
      "additionalProperties": true,
      "default": {}
    },
    "tool_definition_paths": {
      "type": "array",
      "description": "Definition documents loaded relative to the global JAD root; absolute paths are used as-is.",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "default": []
    },
    "tools": {
      "type": "object",
      "properties": {
        "native": {
          "type": "object",
          "properties": {
            "read": {
              "type": "object",
              "properties": {
                "max_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10485760,
                  "default": 65536
                },
                "default_limit": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 250
                },
                "paths": {
                  "type": "array",
                  "description": "Allow/deny path rules. Relative paths resolve from the global JAD root; absolute paths are used as-is. Paths inside cwd are allowed by default; paths outside cwd require an allow rule.",
                  "items": {
                    "type": "object",
                    "required": ["action", "path"],
                    "properties": {
                      "action": {
                        "type": "string",
                        "enum": ["allow", "deny"]
                      },
                      "path": {
                        "type": "string",
                        "pattern": "\\S"
                      }
                    },
                    "additionalProperties": true
                  },
                  "default": []
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "mcp": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "default": {}
    },
    "http_debug": {
      "type": "object",
      "description": "Optional native HTTP diagnostics written as numbered request/response files under paths.http_debug. Disabled by default.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "include_request_headers": {
          "type": "boolean",
          "default": false
        },
        "include_request_body": {
          "type": "boolean",
          "default": false
        },
        "include_response_headers": {
          "type": "boolean",
          "default": true
        },
        "include_response_body": {
          "type": "boolean",
          "default": false
        },
        "max_body_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760,
          "default": 65536
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
