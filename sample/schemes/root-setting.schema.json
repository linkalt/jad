{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "root-setting.schema.json",
  "title": "Agent Harness root setting.json",
  "description": "Workspace-level session roots used by the web UI session list.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "default": 1
    },
    "server": {
      "type": "object",
      "description": "Local HTTP server defaults. Explicit server options and environment variables override these values.",
      "properties": {
        "host": {
          "type": "string",
          "pattern": "\\S",
          "default": "127.0.0.1"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8787
        },
        "max_body_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864,
          "default": 1048576
        }
      },
      "additionalProperties": true,
      "default": {}
    },
    "session_roots": {
      "type": "array",
      "description": "Directories containing session subdirectories.",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "label": {
            "type": "string",
            "pattern": "\\S"
          },
          "path": {
            "type": "string",
            "pattern": "\\S",
            "description": "Session-root directory relative to the system setting.json parent; absolute paths are used as-is."
          }
        },
        "additionalProperties": true
      }
    }
  },
  "required": ["session_roots"],
  "additionalProperties": true
}
